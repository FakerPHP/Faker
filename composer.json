{
    "name": "fakerphp/faker",
    "type": "library",
    "description": "Faker is a PHP library that generates fake data for you.",
    "keywords": [
        "faker",
        "fixtures",
        "data"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "fakerphp/core": "dev-main"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.4.1",
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Faker\\English\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Faker\\English\\": "test/"
        }
    },
    "conflict": {
        "fzaninotto/faker": "*"
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "composer/package-versions-deprecated": true
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "v1.20-dev"
        }
    }
}
