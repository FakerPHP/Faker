{
    "require": {
        "php": "^8.1",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^1.12.25",
        "phpstan/phpstan-deprecation-rules": "^1.2.1"
    },
    "config": {
        "platform": {
            "php": "8.1.32"
        },
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
